# =====================================================================
# OpenProject MCP Server - Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. Core API & Authentication (Required)
# ---------------------------------------------------------------------
# Base URL for OpenProject instance (e.g. https://community.openproject.org or your self-hosted instance)
OPENPROJECT_HOST=https://community.openproject.org

# Authentication API Key (from My Account -> Access Token -> API)
# Or personal access token / password
OPENPROJECT_API_KEY=your_openproject_api_key_here

# Optional: OAuth 2.0 Bearer Token (if using OAuth instead of API Key)
# OPENPROJECT_OAUTH_TOKEN=your_oauth_token_here

# ---------------------------------------------------------------------
# 2. Default Target Project (Optional)
# ---------------------------------------------------------------------
# Default Project ID or identifier (e.g. '14' or 'demo-project')
# If set, tools will automatically fall back to this project ID if omitted in parameters.
OPENPROJECT_DEFAULT_PROJECT_ID=14

# ---------------------------------------------------------------------
# 3. Security & Access Controls (Optional)
# ---------------------------------------------------------------------
# Read-Only Mode: Set to 'true' to block all mutating operations (POST, PATCH, DELETE)
OPENPROJECT_READ_ONLY_MODE=false

# Project Allowlist: Comma-separated list or JSON array of allowed project IDs/identifiers
# OPENPROJECT_PROJECT_ALLOWLIST=14, 15, my-project

# ---------------------------------------------------------------------
# 4. Logging (Optional)
# ---------------------------------------------------------------------
# Enable verbose debug logging on process.stderr (true / false)
DEBUG=false
