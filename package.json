{
  "name": "openproject-mcp",
  "version": "1.0.0",
  "description": "Enterprise OpenProject Model Context Protocol (MCP) Server using FastMCP",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "openproject-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openproject",
    "fastmcp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "1.19.0",
    "axios-retry": "4.5.0",
    "commander": "15.0.0",
    "dotenv": "17.4.2",
    "fastmcp": "^4.16.5",
    "lru-cache": "11.5.2",
    "picocolors": "1.1.1",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^26.2.0",
    "@types/turndown": "5.0.6",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.24.1",
    "vitest": "^4.1.11"
  }
}
